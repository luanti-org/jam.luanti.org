# Required for production. Origins only, without paths; rebuild after changing PUBLIC_API_URL.
# PUBLIC_API_URL=https://api.example.org
# CLIENT_ORIGIN=https://jam.example.org

# Persistent private API storage; never publish it with the client.
DATA_DIR=./data

# Enable only behind a loopback proxy that overwrites X-Real-IP with the client's address.
TRUST_LOCAL_PROXY=0
