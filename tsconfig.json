{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ESNext", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
        "types": ["bun"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["client/**/*.ts", "server/**/*.ts", "shared/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
